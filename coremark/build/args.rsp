-march=rv32i_zmmul_zicsr
-mabi=ilp32
-mcmodel=medlow
-O3
-ffreestanding
-fno-builtin
-fno-common
-fno-strict-aliasing
-ffunction-sections
-fdata-sections
-Wall
-Wextra
-Wno-unused-parameter
-Wno-maybe-uninitialized
-nostdlib
-nostartfiles
-nodefaultlibs
-include
cm_build_flags.h
-ID:/riscv/RISCV/coremark/official
-ID:/riscv/RISCV/coremark/port
-ID:/riscv/RISCV/coremark/bsp
-ID:/riscv/RISCV/coremark/build
-DITERATIONS=7000
-DPERFORMANCE_RUN=1
-DTOTAL_DATA_SIZE=2000
-DCM_CONSOLE=1
-fno-common
-DCM_RETURN_TO_LOADER=1
"D:/riscv/RISCV/coremark/official/core_main.c"
"D:/riscv/RISCV/coremark/official/core_list_join.c"
"D:/riscv/RISCV/coremark/official/core_matrix.c"
"D:/riscv/RISCV/coremark/official/core_state.c"
"D:/riscv/RISCV/coremark/official/core_util.c"
"D:/riscv/RISCV/coremark/port/core_portme.c"
"D:/riscv/RISCV/coremark/port/ee_printf.c"
"D:/riscv/RISCV/coremark/bsp/start.S"
"D:/riscv/RISCV/coremark/bsp/memops.c"
-o
"D:/riscv/RISCV/coremark/build/coremark.elf"
-Wl,-T,D:/riscv/RISCV/coremark/bsp/linker_ddr.ld
-Wl,--gc-sections
-Wl,--no-check-sections
-Wl,-Map=D:/riscv/RISCV/coremark/build/coremark.map
-Wl,--print-memory-usage
-lgcc
