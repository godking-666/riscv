set_max_delay -datapath_only -from [get_cells {u_soc.g_camera.u_camera.u_capture.overflow}] -to [get_cells {u_soc.g_camera.u_camera.overflow_sync*}] 10.000
set_max_delay -datapath_only -from [get_cells {u_soc.g_camera.u_camera.u_capture.format_error}] -to [get_cells {u_soc.g_camera.u_camera.format_sync*}] 10.000
set_max_delay -datapath_only -from [get_ports {camera_scl}] -to [get_cells {u_soc.g_camera.u_camera.u_config.u_bus.scl_sync*}] 10.000
set_max_delay -datapath_only -from [get_ports {camera_sda}] -to [get_cells {u_soc.g_camera.u_camera.u_config.u_bus.sda_sync*}] 10.000

# Intentional asynchronous assertion into the two-flop PCLK reset synchronizer only.
# Synthesized GTP_DFF_C pin C maps to physical RS; do not cut D/CLK or downstream resets.
# Both stages release synchronously to PCLK; preserve their normal clocked timing.
set_false_path -to [get_pins {u_soc.g_camera.u_camera.wr_reset_pipe*/C}]

# Dual-buffer stream warm-up flag is stable before the next run handshake.
set_max_delay -datapath_only -from [get_cells {u_soc.g_camera.u_camera.dual_mode u_soc.g_camera.u_camera.stream_warmed}] -to [get_cells {u_soc.g_camera.u_camera.u_capture.skip_warmup_sync*}] 10.000


